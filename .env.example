# Postgres connection string. Any free-tier Postgres works (Supabase, Neon, Railway).
# Prisma needs a normal (non-pooled) connection for migrations; if your provider
# gives you both a pooled and direct URL, put the pooled one here and add
# DIRECT_URL below for migrations.
DATABASE_URL="postgresql://user:password@host:5432/sbs_leaderboards?sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/sbs_leaderboards?sslmode=require"

# Optional: only needed if you turn on scripts/sync-collection.ts, which reads
# full NFT census data (ownership, traits) directly from OpenSea instead of the
# SBS leaderboard API. Get a free key at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=""

# Contract address + chain for the Banana Best Ball NFT collection, used by
# scripts/sync-collection.ts. Confirm these on the collection's OpenSea page
# (Details panel) before enabling that script — SBS has run multiple
# collections (Banana Best Ball 1-4 etc.) with different contracts.
OPENSEA_COLLECTION_SLUG="banana-best-ball-4"
NFT_CHAIN="base"

# A shared secret your cron job must send so /api/sync can't be triggered by
# randoms hitting your deployed URL. Generate any random string.
SYNC_SECRET="change-me"
